# A stock Debian squid with our configuration. Built here rather than pulled so
# the proxy under test is a known, reproducible package rather than whatever a
# third-party image tag points at this week.
FROM debian:12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends squid \
 && rm -rf /var/lib/apt/lists/*

COPY test/e2e-squid/squid.conf /etc/squid/squid.conf

EXPOSE 3128

# squid drops to the `proxy` user and would create its access log 0640, which the
# harness -- running as a different non-root account in another container --
# could not read. The log is this tier's independent witness, so prepare it
# readable before squid starts. -N foreground, -d1 also to stderr so
# `docker compose logs squid` is useful.
COPY test/e2e-squid/squid-entrypoint.sh /usr/local/bin/squid-entrypoint.sh
RUN chmod +x /usr/local/bin/squid-entrypoint.sh
CMD ["/usr/local/bin/squid-entrypoint.sh"]
